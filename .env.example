# Server
PORT=3005

# MongoDB
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?appName=<appName>

# JWT Secrets (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# Email (Brevo - ücretsiz, domain gerektirmez)
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=your_sender@email.com

# Frontend URL (email doğrulama linki için)
FRONTEND_URL=http://localhost:5173

# Storage: "local" veya "cloudinary"
STORAGE_PROVIDER=local

# Cloudinary (STORAGE_PROVIDER=cloudinary ise doldur)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
